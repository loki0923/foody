# ============================================================================
# FOODY - CONFIGURACIÓN DE VARIABLES DE ENTORNO
# ============================================================================

# URL y Claves de Supabase (Configuración obtenida del Dashboard de Supabase)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key-here

# Dominio base de la aplicación (para generar enlaces de verificación en WhatsApp)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Parámetros Globales de Marca y Negocio
NEXT_PUBLIC_BRAND_NAME=Foody
NEXT_PUBLIC_BRAND_SLOGAN="El sabor de Venezuela a un mensaje de distancia"
NEXT_PUBLIC_DEFAULT_COMMISSION_PCT=3.00
NEXT_PUBLIC_DEFAULT_CURRENCY=USD
NEXT_PUBLIC_SECONDARY_CURRENCY=VES
